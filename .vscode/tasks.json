{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build"
            ],
            "dependsOn": [
                "CMake: Configure"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: Clean",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--target",
                "clean"
            ],
            "dependsOn": [
                "CMake: Configure"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "GStreamer: Inspect minimalfilter",
            "type": "shell",
            "command": "gst-inspect-1.0",
            "args": [
                "minimalfilter"
            ],
            "options": {
                "env": {
                    "GST_PLUGIN_PATH": "${workspaceFolder}/build"
                }
            },
            "dependsOn": [
                "CMake: Build"
            ],
            "problemMatcher": []
        },
        {
            "label": "GStreamer: Inspect opencvfilter",
            "type": "shell",
            "command": "gst-inspect-1.0",
            "args": [
                "opencvfilter"
            ],
            "options": {
                "env": {
                    "GST_PLUGIN_PATH": "${workspaceFolder}/build"
                }
            },
            "dependsOn": [
                "CMake: Build"
            ],
            "problemMatcher": []
        },
        {
            "label": "GStreamer: Inspect propertyfilter",
            "type": "shell",
            "command": "gst-inspect-1.0",
            "args": [
                "propertyfilter"
            ],
            "options": {
                "env": {
                    "GST_PLUGIN_PATH": "${workspaceFolder}/build"
                }
            },
            "dependsOn": [
                "CMake: Build"
            ],
            "problemMatcher": []
        },
        {
            "label": "GStreamer: Run propertyfilter enabled",
            "type": "shell",
            "command": "gst-launch-1.0",
            "args": [
                "videotestsrc",
                "num-buffers=5",
                "!",
                "propertyfilter",
                "enabled=true",
                "!",
                "fakesink"
            ],
            "options": {
                "env": {
                    "GST_PLUGIN_PATH": "${workspaceFolder}/build"
                }
            },
            "dependsOn": [
                "CMake: Build"
            ],
            "problemMatcher": []
        },
        {
            "label": "GStreamer: Run propertyfilter disabled",
            "type": "shell",
            "command": "gst-launch-1.0",
            "args": [
                "videotestsrc",
                "num-buffers=5",
                "!",
                "propertyfilter",
                "enabled=false",
                "!",
                "fakesink"
            ],
            "options": {
                "env": {
                    "GST_PLUGIN_PATH": "${workspaceFolder}/build"
                }
            },
            "dependsOn": [
                "CMake: Build"
            ],
            "problemMatcher": []
        },
        {
            "label": "GStreamer: Run opencvfilter test",
            "type": "shell",
            "command": "gst-launch-1.0",
            "args": [
                "videotestsrc",
                "!",
                "videoconvert",
                "!",
                "video/x-raw,format=BGR",
                "!",
                "opencvfilter",
                "!",
                "videoconvert",
                "!",
                "autovideosink"
            ],
            "options": {
                "env": {
                    "GST_PLUGIN_PATH": "${workspaceFolder}/build"
                }
            },
            "dependsOn": [
                "CMake: Build"
            ],
            "problemMatcher": []
        }
    ]
}