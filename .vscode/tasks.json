{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "CMake: Configure",
            "type": "shell",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}",
                "-B",
                "${workspaceFolder}/build",
                "-DCMAKE_EXPORT_COMPILE_COMMANDS=ON"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "CMake: Build",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build"
            ],
            "dependsOn": [
                "CMake: Configure"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "CMake: Clean",
            "type": "shell",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build",
                "--target",
                "clean"
            ],
            "dependsOn": [
                "CMake: Configure"
            ],
            "group": "build",
            "problemMatcher": []
        },
        {
            "label": "GStreamer: Inspect plugin",
            "type": "shell",
            "command": "gst-inspect-1.0",
            "args": [
                "${input:pluginToInspect}"
            ],
            "options": {
                "env": {
                    "GST_PLUGIN_PATH": "${workspaceFolder}/build"
                }
            },
            "dependsOn": [
                "CMake: Build"
            ],
            "problemMatcher": []
        },
        {
            "label": "GStreamer: Run propertyfilter enabled",
            "type": "shell",
            "command": "gst-launch-1.0",
            "args": [
                "videotestsrc",
                "num-buffers=5",
                "!",
                "propertyfilter",
                "enabled=true",
                "!",
                "fakesink"
            ],
            "options": {
                "env": {
                    "GST_PLUGIN_PATH": "${workspaceFolder}/build"
                }
            },
            "dependsOn": [
                "CMake: Build"
            ],
            "problemMatcher": []
        },
        {
            "label": "GStreamer: Run propertyfilter disabled",
            "type": "shell",
            "command": "gst-launch-1.0",
            "args": [
                "videotestsrc",
                "num-buffers=5",
                "!",
                "propertyfilter",
                "enabled=false",
                "!",
                "fakesink"
            ],
            "options": {
                "env": {
                    "GST_PLUGIN_PATH": "${workspaceFolder}/build"
                }
            },
            "dependsOn": [
                "CMake: Build"
            ],
            "problemMatcher": []
        },
        {
            "label": "GStreamer: Run opencvfilter test",
            "type": "shell",
            "command": "gst-launch-1.0",
            "args": [
                "videotestsrc",
                "!",
                "videoconvert",
                "!",
                "video/x-raw,format=BGR",
                "!",
                "opencvfilter",
                "!",
                "videoconvert",
                "!",
                "autovideosink"
            ],
            "options": {
                "env": {
                    "GST_PLUGIN_PATH": "${workspaceFolder}/build"
                }
            },
            "dependsOn": [
                "CMake: Build"
            ],
            "problemMatcher": []
        },
        {
            "label": "Bridge: Setup Python environment",
            "type": "shell",
            "command": "bash",
            "args": [
                "-lc",
                "python3 -m venv --system-site-packages .venv && .venv/bin/python -m pip install -r apps/bridge_project/requirements.txt"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "build",
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "clear": true
            }
        },
        {
            "label": "Bridge: Run pipeline",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "${workspaceFolder}/apps/run_bridge.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "GST_PLUGIN_PATH": "${workspaceFolder}/build"
                }
            },
            "dependsOn": [
                "CMake: Build",
                "Bridge: Setup Python environment"
            ],
            "dependsOrder": "sequence",
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "clear": true,
                "group": "bridge"
            }
        },
        {
            "label": "Bridge: Run GUI",
            "type": "shell",
            "command": "${workspaceFolder}/.venv/bin/python",
            "args": [
                "${workspaceFolder}/apps/run_bridge_gui.py"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": [
                "Bridge: Setup Python environment"
            ],
            "isBackground": true,
            "problemMatcher": [],
            "presentation": {
                "panel": "dedicated",
                "clear": true,
                "group": "bridge"
            }
        },
        {
            "label": "Bridge: Run project",
            "dependsOn": [
                "Bridge: Run pipeline",
                "Bridge: Run GUI"
            ],
            "dependsOrder": "parallel",
            "group": {
                "kind": "test",
                "isDefault": true
            },
            "problemMatcher": []
        }
    ],
    "inputs": [
        {
            "id": "pluginToInspect",
            "type": "pickString",
            "description": "Select a GStreamer plugin to inspect",
            "options": [
                "minimalfilter",
                "propertyfilter",
                "metaattach",
                "metaprint",
                "simplevideosrc",
                "colorboxsrc",
                "grayfilter",
                "reddetect",
                "controlledreddetect",
                "opencvfilter"
            ],
            "default": "minimalfilter"
        }
    ]
}
